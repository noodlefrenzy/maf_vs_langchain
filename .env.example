# Shared OpenAI-compatible local inference endpoint.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=local-only
MODEL_NAME=Qwen/Qwen3.5-9B

# Framework-neutral trace collector and UI.
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# The incident lab uses separate state per run. Never reuse a state directory
# between the two sides of a paired comparison.
AGENT_LAB_RUN_ROOT=./runs
INCIDENT_LAB_SEED=42
INCIDENT_LAB_FAULT_PROFILE=standard

# Raw model reasoning is intentionally not persisted by default.
AGENT_LAB_CAPTURE_SENSITIVE=false
AGENT_LAB_CAPTURE_REASONING=false
